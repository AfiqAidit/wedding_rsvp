# Copy to .env.local for local dev. On Vercel, add the same names under Project → Settings → Environment Variables.

# Passcode for /admin (the host's list of responses). Required for /admin to work.
ADMIN_PASSCODE=change-me

# Maximum pax a guest can pick (default 10).
MAX_PAX=10

# Supabase (production). Leave both empty locally and responses go to .data/rsvps.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
